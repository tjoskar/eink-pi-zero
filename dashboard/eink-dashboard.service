# systemd user unit for the Dashboard, installed by `pnpm pi:deploy dashboard <host>`.
# Starting at boot needs lingering, once per Pi: sudo loginctl enable-linger $USER
# Logs: journalctl --user-unit eink-dashboard -f

[Unit]
Description=Home Dashboard on the e-ink panel
# Give up after 5 crashes within an hour instead of retrying forever.
StartLimitIntervalSec=1h
StartLimitBurst=5

[Service]
WorkingDirectory=%h/eink/dashboard
ExecStart=/usr/bin/node --env-file=.env --enable-source-maps dist/main.js
# Panel power, RST, DC and the LED (GPIO 13) low after any stop, also SIGKILL
# or a crash, when the app's own cleanup could not run.
ExecStopPost=/usr/bin/node node_modules/@tjoskar/eink/dist/cleanup.js 13
Environment=TZ=Europe/Stockholm NODE_ENV=production
Restart=on-failure
RestartSec=60
# 75: the Framework stopped a render loop. Stay down until restarted by hand.
RestartPreventExitStatus=75

[Install]
WantedBy=default.target
