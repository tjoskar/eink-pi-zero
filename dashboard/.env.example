# The Dashboard's settings on the Pi. Copy to .env.pi (gitignored) and fill in;
# `pnpm pi:deploy dashboard <host>` copies it to the Pi as .env.

# MQTT
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# OpenWeatherMap
WEATHER_API_KEY=
WEATHER_LAT=
WEATHER_LON=
WEATHER_UNITS=metric
WEATHER_LANG=en

# Tibber
TIBBER_TOKEN=

# API
API_TIMEOUT=10000
CACHE_DURATION=3600

# Dishes
DISHES_API_URL=
