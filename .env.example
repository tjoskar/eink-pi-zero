# MQTT
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Only used by the mqtt-device-status example; the Dashboard uses controlpanel/.
MQTT_TOPIC_PREFIX=statechange

# Weather. WEATHER_LAT/LON are shared; the rest is OpenWeatherMap for the
# fetch-example-openweather example (the Dashboard uses SMHI, no key).
WEATHER_LAT=
WEATHER_LON=
WEATHER_API_KEY=
WEATHER_UNITS=metric
WEATHER_LANG=en

# Tibber
TIBBER_TOKEN=

# API
API_TIMEOUT=10000
CACHE_DURATION=3600

# Dishes
DISHES_API_URL=
